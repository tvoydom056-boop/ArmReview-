DATABASE_URI=file:./armreview.db
# На сервере база и картинки лежат вне папки релиза (DEPLOY.md § 2):
#   DATABASE_URI=file:///var/lib/armreview/armreview.db
#   MEDIA_DIR=/var/lib/armreview/media
# Секреты — случайные строки, заглушки ниже приложение не примет. Сгенерировать:
#   openssl rand -hex 32   или   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string
IP_HASH_SALT=change-me-to-another-random-string
SITE_URL=http://localhost:3000

# Только для Vercel + Turso (см. deploy/VERCEL.md); локально и на VPS не нужны
# DATABASE_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=

DATABASE_URI=file:./armreview.db
# Секреты — случайные строки, заглушки ниже приложение не примет. Сгенерировать:
#   openssl rand -hex 32   или   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string
IP_HASH_SALT=change-me-to-another-random-string
SITE_URL=http://localhost:3000


{
  "name": "armreview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "test": "vitest run",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.90.0",
    "@payloadcms/next": "3.90.0",
    "@payloadcms/richtext-lexical": "3.90.0",
    "@payloadcms/translations": "3.90.0",
    "@payloadcms/ui": "3.90.0",
    "@tanstack/react-query": "5.103.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "payload": "3.90.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.5",
    "flag-icons": "7.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}

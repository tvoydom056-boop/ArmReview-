# Копировать в /etc/armreview/backup.env: sudo install -m 600 -o root -g root (DEPLOY.md § 5)
# rclone-путь вне сервера: crypt-remote поверх S3-бакета в РФ, подпапка daily
BACKUP_REMOTE=armreview-crypt:daily
# Необязательно: адрес пинга Healthchecks-совместимого сервиса (успех — URL, сбой — URL/fail)
BACKUP_PING_URL=
